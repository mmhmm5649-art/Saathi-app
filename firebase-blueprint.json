{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, companion voice/language preferences, and privacy toggles for SAATHI.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "preferredName": {
          "type": "string",
          "description": "Optional preferred nickname SAATHI should call the user."
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile avatar URL."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["TELUGU", "HINDI", "ENGLISH"],
          "description": "Active conversation language."
        },
        "selectedVoiceId": {
          "type": "string",
          "description": "Selected ElevenLabs voice identifier."
        },
        "selectedVoiceGender": {
          "type": "string",
          "enum": ["MALE", "FEMALE"],
          "description": "Selected voice category."
        },
        "speechSpeed": {
          "type": "number",
          "description": "Speech playback speed multiplier (0.5 to 2.0)."
        },
        "speechVolume": {
          "type": "number",
          "description": "Speech playback volume (0.0 to 1.0)."
        },
        "autoPlayVoice": {
          "type": "boolean",
          "description": "Whether voice responses auto-play."
        },
        "memoryEnabled": {
          "type": "boolean",
          "description": "Whether long-term memory is active."
        },
        "cloudSyncEnabled": {
          "type": "boolean",
          "description": "Whether cloud sync to Firestore is enabled."
        },
        "dailyRemindersEnabled": {
          "type": "boolean",
          "description": "Optional daily companion check-in reminder toggle."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "preferredLanguage",
        "selectedVoiceId",
        "selectedVoiceGender",
        "speechSpeed",
        "speechVolume",
        "autoPlayVoice",
        "memoryEnabled",
        "cloudSyncEnabled",
        "dailyRemindersEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemoryItem": {
      "title": "MemoryItem",
      "description": "Explicitly saved long-term memory item for SAATHI.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "category": {
          "type": "string",
          "description": "Memory category such as Name, Interest, Project, Preference, Context."
        },
        "content": {
          "type": "string",
          "description": "Concise user-approved memory fact."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "category", "content", "createdAt", "updatedAt"]
    },
    "ConversationRecord": {
      "title": "ConversationRecord",
      "description": "Synced conversation session metadata.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Conversation title."
        },
        "languageCode": {
          "type": "string",
          "enum": ["TELUGU", "HINDI", "ENGLISH"],
          "description": "Language of the conversation."
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Latest message preview."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "languageCode", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "MessageRecord": {
      "title": "MessageRecord",
      "description": "Individual message inside a synced conversation.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "description": "Sender role."
        },
        "text": {
          "type": "string",
          "description": "Message text content."
        },
        "isVoice": {
          "type": "boolean",
          "description": "True if originated from voice conversation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "role", "text", "isVoice", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and companion preferences."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/MemoryItem" },
      "description": "Per-user saved long-term memories."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ConversationRecord" },
      "description": "Per-user synced conversation threads."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MessageRecord" },
      "description": "Messages belonging to a synced conversation."
    }
  }
}
