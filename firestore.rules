rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLanguage(lang) {
      return lang in ['TELUGU', 'HINDI', 'ENGLISH'];
    }

    function isValidGender(gender) {
      return gender in ['MALE', 'FEMALE'];
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('preferredName' in data) || data.preferredName == null || (data.preferredName is string && data.preferredName.size() <= 60)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             isValidLanguage(data.preferredLanguage) &&
             data.selectedVoiceId is string && data.selectedVoiceId.size() >= 1 && data.selectedVoiceId.size() <= 100 &&
             isValidGender(data.selectedVoiceGender) &&
             data.speechSpeed is number && data.speechSpeed >= 0.5 && data.speechSpeed <= 2.0 &&
             data.speechVolume is number && data.speechVolume >= 0.0 && data.speechVolume <= 1.0 &&
             data.autoPlayVoice is bool &&
             data.memoryEnabled is bool &&
             data.cloudSyncEnabled is bool &&
             data.dailyRemindersEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMemoryItem(data, userId) {
      return data.userId == userId &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConversationRecord(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             isValidLanguage(data.languageCode) &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessageRecord(data, userId) {
      return data.userId == userId &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
             data.isVoice is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredLanguage', 'selectedVoiceId',
                         'selectedVoiceGender', 'speechSpeed', 'speechVolume', 'autoPlayVoice',
                         'memoryEnabled', 'cloudSyncEnabled', 'dailyRemindersEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'preferredName', 'photoUrl', 'preferredLanguage',
                         'selectedVoiceId', 'selectedVoiceGender', 'speechSpeed', 'speechVolume',
                         'autoPlayVoice', 'memoryEnabled', 'cloudSyncEnabled', 'dailyRemindersEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'preferredName', 'photoUrl', 'preferredLanguage',
                         'selectedVoiceId', 'selectedVoiceGender', 'speechSpeed', 'speechVolume',
                         'autoPlayVoice', 'memoryEnabled', 'cloudSyncEnabled', 'dailyRemindersEnabled',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().keys().hasAll(['userId', 'category', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'category', 'content', 'createdAt', 'updatedAt']) &&
                         isValidMemoryItem(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'content', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().keys().hasAll(['userId', 'title', 'languageCode', 'lastMessagePreview', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'languageCode', 'lastMessagePreview', 'createdAt', 'updatedAt']) &&
                         isValidConversationRecord(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversationRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'languageCode', 'lastMessagePreview', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(conversationId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll(['userId', 'role', 'text', 'isVoice', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'role', 'text', 'isVoice', 'createdAt']) &&
                           isValidMessageRecord(incoming(), userId);

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }
    }
  }
}
