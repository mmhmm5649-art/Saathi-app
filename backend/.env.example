# Required: Gemini API Key (kept strictly on the backend, never in the Android APK)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Primary and fallback Gemini models
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Required for ElevenLabs speech: ElevenLabs API Key (kept strictly on the backend, never in the Android APK)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional: Pin specific Indian Female and Male Voice IDs from the ElevenLabs Voice Library.
# If omitted, the backend discovers suitable Indian voices from your ElevenLabs account/library,
# or you can configure them from the app's Voice Settings screen.
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_NAME=Ananya (Indian Female)
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_MALE_VOICE_NAME=Arjun (Indian Male)

# Optional: Primary TTS and STT models (automatic fallback if unavailable on plan)
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v3_live

# Optional Security Hardening for Public Deployments
# If set, requests must provide matching X-Saathi-Client-Token or Authorization: Bearer <token>
SAATHI_BACKEND_ACCESS_TOKEN=
# Set to "true" behind TLS-terminating reverse proxies (Cloud Run, Render, Fly.io, etc.)
REQUIRE_HTTPS=false
PORT=8080
